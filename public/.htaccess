<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes +FollowSymLinks
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # Direct access to index.html should not be rewritten
    RewriteRule ^index\.html$ - [L]

    # If requested file or directory physically exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React Single Page Application (SPA) Routing: All requests route to index.html
    RewriteRule ^ index.html [L]
</IfModule>