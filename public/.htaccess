<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes +FollowSymLinks
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # Bypass LiteSpeed Symlink Protection on Hostinger by routing storage requests through Laravel
    RewriteRule ^storage/(.*)$ index.php [L,QSA]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # If backend index.php exists and request is for api or storage, route to index.php
    RewriteCond %{DOCUMENT_ROOT}/index.php -f
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^/(api|storage|sanctum) [NC]
    RewriteRule ^ index.php [L,QSA]

    # If requested file or directory physically exists, serve it
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # If index.php exists, route to index.php (Laravel front controller)
    RewriteCond %{DOCUMENT_ROOT}/index.php -f
    RewriteRule ^ index.php [L]

    # If no index.php, fallback to index.html for SPA (React Router)
    RewriteRule ^ index.html [L]
</IfModule>
